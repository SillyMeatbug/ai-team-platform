# Путь к YAML с маршрутами (относительно корня процесса или абсолютный)

ROUTES_YAML_PATH=routes.yaml



# Уровень логов: DEBUG, INFO, WARNING, ERROR

LOG_LEVEL=INFO



# OpenRouter — единый шлюз LLM (https://openrouter.ai); ключ только в локальном `.env`

OPENROUTER_API_KEY=

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Заголовки для статистики на стороне OpenRouter

OPENROUTER_HTTP_REFERER=http://127.0.0.1:8000

OPENROUTER_APP_TITLE=AI Team Platform



# true — без реальных вызовов OpenRouter (удобно без оплаты). false — живые запросы.

AGGREGATE_MOCK=true



# Кэш ответов агрегации (секунды TTL по умолчанию).

CACHE_TTL_SECONDS=300



# Бюджет: лимит на запрос и суточный потолок (USD).

MAX_COST_PER_REQUEST=0.10

MAX_DAILY_COST=5.00



# Платформа коллаборации: БД и файловое хранилище.

DATABASE_URL=sqlite+aiosqlite:///./ai_platform.db

UPLOAD_DIR=./uploads

MAX_FILE_SIZE_MB=10

ALLOWED_FILE_TYPES=pdf,doc,docx,txt,png,jpg,jpeg,gif,webp,fig,md,csv,json,xml,html,yml,yaml



# Параметры оркестратора чата.

CHAT_HISTORY_LIMIT=20

CHAT_DEFAULT_TEMPERATURE=0.7

CHAT_RESPONSE_TIMEOUT_MS=60000
# Базовый бюджет (мс) на раунд для ~3 агентов; лимит всего треда = масштабирование × раунды × (агенты/3) + запас на синтез, но не выше CAP.
CHAT_DEBATE_TIMEOUT_MS=120000
CHAT_DEBATE_TIMEOUT_CAP_MS=900000
CHAT_DEBATE_MAX_ROUNDS=5

# Вложения в промпт: текст (на файл / общий) и лимит картинок для vision.

CHAT_FILE_TEXT_MAX_CHARS=48000

CHAT_FILE_TOTAL_TEXT_MAX_CHARS=120000

CHAT_FILE_MAX_IMAGES=6

CHAT_IMAGE_MAX_SIDE_PX=1536

CHAT_IMAGE_MAX_BYTES=12000000



# Файлы по умолчанию для агента (рулбуки): POST/GET/DELETE /v1/agents/{agent_id}/library

